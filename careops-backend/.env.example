NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/careops
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
SESSION_MINUTES=30
STORAGE_DIR=./storage
# AI is off by default: documents get a manual-review fallback (no invented values)
AI_ENABLED=false
AI_PROVIDER=none
# Set when a malware scanner is wired in (required for production uploads)
MALWARE_SCANNER=
# Used by `npm run seed` only (synthetic demo users). Leave empty to generate one.
SEED_PASSWORD=
